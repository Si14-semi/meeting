generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// 반복 주기 (구글캘린더 동일 컨셉)
enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// 월간 반복 방식: 매월 같은 날짜(예: 15일) vs 매월 n번째 요일(예: 셋째 화요일)
enum MonthlyMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               Role     @default(USER)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  reservations Reservation[]
  series       RecurringSeries[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Room {
  id          Int     @id @default(autoincrement())
  number      String  @unique // 예: "120", "A1", "6958"(차량)
  building    String  @default("평화") // 건물/그룹 탭: 평화, 아리랑&신원, 차량
  floor       Int // 예: 12, 13 (건물에 층 구분이 없으면 1)
  alias       String? // 호칭 (예: "1호") — 회의실 정보에 "12층 1호"로 표시
  capacity    Int?
  description String? // 자유 입력 정보 (장비, 위치 등 — 관리자모드에서 입력)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  reservations Reservation[]

  @@map("rooms")
}

model RecurringSeries {
  id          String       @id @default(cuid())
  userId      String
  frequency   Frequency
  interval    Int          @default(1) // n일/주/개월/년 마다
  weekdays    Int[]        @default([]) // WEEKLY용: 0(일)~6(토)
  monthlyMode MonthlyMode? // MONTHLY용
  startDate   String // "YYYY-MM-DD" (KST)
  endDate     String? // 종료일 (미지정 시 시작일+1년으로 전개)
  count       Int? // 종료 횟수
  createdAt   DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@map("recurring_series")
}

model Reservation {
  id        String   @id @default(cuid())
  roomId    Int
  userId    String
  date      String // "YYYY-MM-DD" (KST) — 예약은 하루를 넘을 수 없음
  startMin  Int // 00:00 기준 분 (480 = 08:00)
  endMin    Int // exclusive (1140 = 19:00)
  purpose   String   @default("")
  seriesId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  series RecurringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([userId, date])
  @@index([seriesId])
  @@map("reservations")
}

// 관리자 팝업 공지 — 활성 상태는 최대 2개까지 (API에서 강제)
model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}

model Holiday {
  date String @id // "YYYY-MM-DD"
  name String

  @@map("holidays")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String // FORCE_CANCEL / FORCE_UPDATE / RESET_PASSWORD / DELETE_USER / ...
  detail    Json // 대상 예약/회원 스냅샷
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
