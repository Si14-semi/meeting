# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.onprem.example

# 비밀정보 메모 파일 — 커밋/번들 금지
*passwd*
*password*.txt
Neon*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local settings
/.claude/
