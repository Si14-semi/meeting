# ============================================================
# Meeting Room 예약 — 사내 운영 서버 .env 템플릿
# ============================================================
# 이 파일을 D:\Meeting\.env 로 복사한 뒤 실제 값으로 채운다.
# .env 는 절대 zip/git 에 포함되지 않는다 (build-deploy-zip.ps1 이 자동 검사).
# 값 생성 예 (PowerShell):
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ============================================================

# 사내 PostgreSQL — setup-db.sql 에서 정한 meeting_app 비밀번호로 교체
DATABASE_URL="postgresql://meeting_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/meeting_prod?schema=public"

# 세션 JWT 서명 키 — 64자 이상 무작위 문자열 (Vercel 것과 달라도 됨. 다르면 기존
# 브라우저 세션이 무효화되어 전 직원 재로그인 1회 필요 — 전환 공지에 포함할 것)
AUTH_SECRET=CHANGE_ME_RANDOM_64_CHARS

# 일일 정리 작업(run-cleanup.ps1) 인증용 — 무작위 문자열
CRON_SECRET=CHANGE_ME_RANDOM_32_CHARS

# 사내서버는 HTTP 운영 → secure 쿠키 해제 (이 줄이 없으면 로그인 불가)
# HTTPS 도입 시 이 줄을 삭제하면 secure 쿠키로 복귀
COOKIE_SECURE=false

# 초기 시드용 (깨끗한 시작 시 `npx prisma db seed` 1회에만 사용)
# 관리자 계정 생성 — 최초 로그인 시 비밀번호 변경이 강제됨. 시드 후 삭제해도 무방.
ADMIN_EMAIL=CHANGE_ME@dwanatech.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TEMP_PASSWORD
