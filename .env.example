# ===== meeting 환경변수 =====
# Vercel 배포 시 Project Settings → Environment Variables 에 아래 값들을 설정하세요.

# Neon PostgreSQL 연결 문자열 (Vercel 마켓플레이스에서 Neon 연동 시 자동 주입 가능)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT 서명 키 — 반드시 무작위 문자열로 새로 생성 (예: openssl rand -base64 32)
AUTH_SECRET=""

# 최초 seed 시 생성할 관리자 계정
ADMIN_EMAIL="admin@dwanatech.com"
ADMIN_INITIAL_PASSWORD=""

# Vercel Cron 인증 키 — 무작위 문자열로 생성
CRON_SECRET=""
